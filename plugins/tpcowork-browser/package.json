{
  "name": "@tpcowork/dsh-browser",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Persistent, visible browser automation for the DSH desktop",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./desktop": "./lib/desktop.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "node tests/native-smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.59.1",
    "ws": "8.19.0",
    "zod": "4.3.6"
  }
}
