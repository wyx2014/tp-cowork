{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "rootDir": "./src",
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../../deepseek-harness/node_modules/@types"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ]
}