{
  "name": "@tpcowork/dsh-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "TP Cowork appearance for DeepSeek Harness desktop and web",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": ["index.js", "client.js", "styles.css", "upstream.css", "theme.json", "cordis.patch.yml", "locale/*.json", "icon.png", "README.md"],
  "scripts": { "build": "node build.mjs", "check": "node --check index.js && node --check client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
