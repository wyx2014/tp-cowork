{
  "name": "@tpcowork/dsh-core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "TP Cowork product identity, office assistant instructions and intranet DeepSeek defaults for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./model": "./model.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "model.js", "deployment.js", "deployment.local.json", "persona.md", "cordis.patch.yml", "model.patch.yml", "locale/*.json", "README.md"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@earendil-works/pi-ai": "^1.0.2"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check index.js && node --check model.js && node --check deployment.js && node --check build.mjs",
    "typecheck": "node ../../../deepseek-harness/node_modules/typescript/bin/tsc -p tsconfig.json",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "bundle": { "patch": ["./cordis.patch.yml", "./model.patch.yml"] }
  }
}
