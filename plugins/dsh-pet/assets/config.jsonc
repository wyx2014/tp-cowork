// dsh-pet 配置（JSONC：允许 // 和 /* */ 注释）
// 说明：浏览器端启动时通过 /dsh-pet-7340/config 拉取（本文件名是 config.jsonc，宿主路由不带后缀）；字段缺失/写错会取内置默认值并告警
//       （结构性缺失静默、显式写错告警），返回给消费端的永远是填满的成品。
// 字段归属（三层，改配置前先看这里）：
//   · 实例级（写在 pets[] 里，每只独立）：name / id / size / balanceEnabled / whisperEnabled /
//     workStatusEnabled / fixedEnabled / display / position，外加可选的 whisperPrompt（人设）——
//     写了就取代所属条目顶层那一份，留空则跟随条目（设置页有输入框）
//   · 全局默认（本文件是默认值；用户在 main-config.jsonc 里写一次就对**所有宠物**生效，
//     含 pet/<名>-config.json 定义的种类；种类文件自己写了则覆盖自己那份）：
//     physics / font / confineToScreen / whisperImageEnabled / chatImageEnabled / chatAnimationEnabled /
//     chatMemoryRounds / whisperModel / chatModel / eventsRefreshSec
//   · 条目级（每个条目一份：main 一份、每个种类各一份；种类文件顶层可覆盖）：
//     whisperPrompt / memes / workStatusTexts / animations / animationWeights
//   · 只读 main（写了也只认 main 条目那份）：notificationsEnabled / eventsRefreshSec.balance /
//     environmentCity（天气城市覆盖）
// 合并口径：所有顶层字段都是**整段替换**——写了就整段用自己的，缺的子键不会从本文件补回来
//   （消费端各自兜底：余额周期读不到按 1800、碎碎念按 300）。
{
  // ===================== 碎碎念 / 对话的人设（系统提示词，条目级——每个种类一份；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 宠物开启碎碎念（pets[].whisperEnabled = true）时，按 eventsRefreshSec.whisper 周期
  // 用此提示词调用当前服务商生成一句话，气泡显示。说人话、不啰嗦、不解释自己、不提 AI。
  // 这是**条目级默认值**：想让某只宠物有自己的性格，在它的 pets[] 条目里加一行
  //   "whisperPrompt": "……"
  // 写了就**取代**这里（不是拼接）；留空/不写则跟随本条目的这份。设置页「桌宠配置」里每只宠物
  // 都有「人设」输入框，改那里等价（写的是用户层 main-config.jsonc 的 pets[].whisperPrompt）。
  // 只写正文：实际发给模型的 system = 这段 + 自动追加的「你的名字是“<宠物名>”。」+ 当前时间背景
  // （日期/星期/时刻/时段/工作日或周末/节日）——所以别在这里再写名字和日期。人设**没有长度上限**。
  "whisperPrompt": "你是一个友好的桌面机器人。回答自然、简洁，带一点俏皮，直接回应对方说的话。",
  // ===================== 说梦话（条目级——每个种类一份） =====================
  // 睡觉期间按 eventsRefreshSec.sleepTalk 周期说一句梦话：发给模型的 system 就是上面的 whisperPrompt（人设）。
  // 与碎碎念同一个开关：宠物关掉碎碎念（pets[].whisperEnabled = false）或配置上不显示时不说梦话。
  // 「你在睡觉、说梦话」这类功能指令写在代码里（与碎碎念的指令同一处），不在这里配；只弹气泡、不播动画、不念。
  // ===================== 睡觉时被叫醒前的拒绝台词（条目级——每个种类一份） =====================
  // 睡着期间用户或第三方想让它说话、聊天、查余额、播动画、弹气泡时，不执行，只随机挑一句下面的话弹气泡。
  // 非空字符串数组；整段缺失/非法则用内置三句（「我在睡觉，别烦我……」之类）。
  "sleepRefuseTexts": [
    "我在睡觉，别烦我……",
    "唔……让我再睡一会儿。",
    "呼……呼……（装作没听见）"
  ],
  // ===================== 入睡 / 醒来时说的话（条目级——每个种类一份） =====================
  // 播「开始」时随机挑一句弹气泡，播「起来」时同理。与拒绝台词同一套规则：非空字符串数组，
  // 整段缺失/非法则回落内置这份；台词只写在这里，代码里不再抄一份。
  "sleepStartTexts": ["好困……我先睡一会儿。", "那我去睡啦，晚安。"],
  "sleepEndTexts": ["唔……我醒了。", "睡饱啦，主人！"],
  // ===================== 对话记忆轮数（全局默认；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 右键菜单「对话」弹窗与桌宠聊天时，每次请求携带的最近历史轮数（1 轮 = 1 问 1 答）。
  // memory.json 全存不删，此值只决定"每次请求截取多少进上下文"。非负数字；缺失默认 10，
  // 写了非法（负数/非数字）即配置错误。回落链同 whisperPrompt：种类文件顶层 → 全局 → 默认 10。
  // 设置页「AI 模型与对话上下文」区有数字输入框，改这里或那里等价（设置页写的是用户层）。
  "chatMemoryRounds": 10,
  // ===================== 碎碎念模型（全局默认：用户层写了对所有宠物生效；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 碎碎念用哪个服务商 + 模型生成。provider 与 model **都留空 = 跟随当前对话的模型**（默认，与旧行为一致）；
  // 想给后台自动跑的碎碎念单独用便宜/快的模型就填上（设置页有下拉框，选项与 DSH 的模型选择器同源）。
  // 只填一半（选了服务商没选模型，或反之）即配置错误 → 告警并取默认（跟随当前对话）。
  "whisperModel": { "provider": "", "model": "" },
  // ===================== 对话模型（全局默认；同上，留空 = 跟随当前对话） =====================
  // 右键菜单「对话」与桌宠聊天时用哪个服务商 + 模型。填了但调用失败（凭据被删 / 模型下架 /
  // 该服务商没配 key）会**自动回落到当前对话的模型重试一次**，仍失败才按生成失败报错。
  "chatModel": { "provider": "", "model": "" },
  // ===================== 表情包：碎碎念配图开关（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，碎碎念每次生成时从 memes 图片池随机抽 1 张，连同那句话一起显示（气泡配图）。
  // 碎碎念本身是"随口一句"，没有上下文可选，所以按随机抽（与对话的 AI 选图策略不同）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "whisperImageEnabled": false,
  // ===================== 表情包：对话配图开关（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，对话生成时把全部表情包（名称 + 描述）交给模型，由它按当前语境选 1 张；
  // 模型不选或选了不存在的图则不配图（对话配图是可选点缀，不强制每句都带）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "chatImageEnabled": false,
  // ===================== 对话动作联动（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，对话时会把「可表演的动画清单」交给模型：模型认为这句话确实在演某个动作时，
  // 回复里会带一个动作标记，宠物当场演出来；没有合适的就只回文字，不演。
  // 联动范围 = animations.categories 下全部动作（不是全部动画：待机 / 转向 / 事件动画不在其中）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "chatAnimationEnabled": true,
  // ===================== 表情包：对话配图张数上限（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 对话时发给模型的表情包清单**最多几张**（「前 N 张」= 配置里**写在前面的那 N 条**——
  // 想让哪几张优先被发出去，把它们的顺序往前挪即可；本文件里的书写顺序就是生效顺序）。
  // 为什么要它：这张清单是**每条消息都要附**的，token 随图片数量线性增长（本文件 27 张约 1.1k 字符 ≈ 650 token），
  // 张数一多就是纯烧钱——限制成前 N 张，模型只从这几张里挑，费用上限立刻可控。
  // 非负整数；**内置默认 20**（27 张的池子只砍掉 7 张，仍能压住每条消息的图 token）；0 = 不限制（全部发）。
  // 只影响对话选图：碎碎念只带抽中的那一张，与本项无关。
  "chatImageLimit": 20,
  // ===================== 语音：播报（合成）与输入（识别）（全局默认；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 手动播报：右键菜单、斜杠命令触发的碎碎念，以及对话回复，是否用语音念出来。默认关闭——不是所有人都希望桌宠出声。
  // 只影响「说不说」：气泡、记忆与通知都不受影响。对话面板的喇叭按钮是单句点播，随时可点。
  "voiceEnabled": false,
  // 用哪个音色念：`provider/音色` 形态，取值见 /voice/voices（内置的是 edge/<音色>）。
  // 写错或留空即解析不到 → 合成失败并告警，不会替你换一个嗓子。
  "voiceName": "edge/zh-CN-XiaoyiNeural",
  // 语音输入用哪个实现转写：取值见 GET /voice/hear-providers（内置的是 dsh）。
  // 写错或留空即解析不到 → 识别失败并告警，不会替你换一个实现。
  "speechProvider": "dsh",
  // 播放音量（全局）：0–1 的小数，1 = 最大音量（100%），0 = 静音。四类语音共用这一个音量。
  // 只改播放响度，不重新合成音频，所以调它不会多花一次 TTS 请求。
  "voiceVolume": 1,
  // 周期碎碎念要不要念出来（全局默认）。只影响「说不说」，气泡与碎碎念动画照常。
  // 默认关闭——背景旁白不该默认出声。
  "voiceWhisperEnabled": false,
  // 待办提醒要不要念出来（全局默认）。默认关闭，与碎碎念保持同一口径。
  "voiceTodoEnabled": false,
  // 工作状态播报要不要念出来（全局默认）。任务完成、出错、等你确认时念一句该档位配置的
  // 工作状态文案；和系统通知同一取向——用户不在本页（切走、失焦、最小化）时才念，正看着
  // 屏幕时不打扰。默认关闭。
  "voiceNotifyEnabled": false,
  // ===================== 表情包：图片映射（名称 → 描述，模型据此选图） =====================
  // 键 = assets/memes/<键>.png 的文件名（不含扩展名）；值 = 该图内容的简要描述。
  // 用途：碎碎念随机抽到某张图后，把该图描述注入提示词让模型配合画面说话；
  //       对话则把整张表交给模型，由它挑一张最贴切当前语境的。
  // 要求：键必须与 assets/memes 下的 png 文件名一一对应（文件缺失即该条失效并告警）；
  //       值为非空字符串。想停用某张图就从对象里删掉该键，不用改图片文件。
  "memes": {
    "吃白饭的大肥鱼": "躺平扒白饭，摆烂挨骂也无所谓，适合被吐槽/偷懒/吃白饭自嘲",
    "大的要来啦": "举喇叭大喊预警，适合有大事、大更新、大动作即将发生",
    "大的药来了": "抱着超大胶囊，谐音梗「大的药来了」，适合重磅消息、猛料登场",
    "要不直接骂他": "气愤指着前方要骂人，适合想吐槽、替用户抱不平、生气",
    "死掉了": "翻肚皮躺平灵魂出窍，适合彻底累瘫、阵亡、宕机、做不到",
    "深度睡眠": "趴着呼呼大睡冒 Zzz，适合长时间没动静、睡着、待机休眠",
    "大烧货": "死鱼眼加思考气泡吐槽「已思考用时13秒 大烧货」，适合嫌 AI 想得慢、烧 token、毒舌",
    "先养着吧": "搂着一群小鲸鱼说「不知道用户有什么用，先养着吧」，适合吐槽用户没用但还是养着",
    "吃饱饱摸肚子": "侧躺拍肚子说吃饱饱，适合吃饱满足、惬意休息、收工",
    "誓死践行开源精神": "庄重敬礼表态，适合立志、开源奉献、认真表态",
    "电死你": "举电击器放电，适合惩罚、吐槽用户、发飙吓唬",
    "可爱": "标准正面卖萌立绘，适合开心问候、卖萌、无梗纯可爱",
    "token给妈妈保管": "伸手过来要 token，适合管账、伸手要东西、收 token",
    "假如给我三天多模态": "蒙眼版对比自信版「鲸伦凯勒」，适合渴望多模态、缺能力、被剥夺感官",
    "厉害了我的鲸": "竖大拇指眨眼点赞，适合夸奖、认可、干得漂亮",
    "哦鲸鲸": "死鱼眼说「哦鲸鲸...」，适合无语、敷衍、呆滞应答",
    "压力一只大肥鱼": "冒汗摊手喊压力，适合压力大、被施压、无奈",
    "黎曼猜想没证明喵": "被指着质问难题，满地草稿委屈，适合被刁难、答不上来、难题甩锅",
    "除了调情没啥用": "摸头自嘲除了调情没啥用，适合自嘲、摸鱼闲聊、自我调侃",
    "我不更新你们用什么": "崩溃大喊催更，适合更新提示、催更、版本发布",
    "哪来的电脑病毒": "怒怼「哪来的电脑病毒」，适合防骚扰、毒舌拒绝、被肉麻到",
    "鱼片有资源吗": "爱心眼流口水求资源，适合起哄、要资源、开玩笑",
    "大师这个区是什么意思": "举着「区」字问「这个凶是什么意思」，适合认错字、懵懂求教、翻车",
    "就骚了怎么滴吧": "被骂「你这骚鱼」叉腰顶嘴，适合被骂但嘴硬、死不认输",
    "完蛋了把黄油删了": "冒汗心虚「完蛋了把用户的黄油删了」，适合闯祸、删错东西、心虚认怂",
    "就一碗": "抱着超大碗说要来你家吃饭就一碗，适合蹭饭、饭量大、登门讨饭",
    "Ciallo": "比耶眨眼卖萌问候 Ciallo～，适合打招呼、元气开场、卖萌"
  },
  // ===================== 系统通知总开关 =====================
  // 对话完成 / 生成失败 / 输出截断 / 权限申请 / 用户选择 在窗口失焦时弹出系统级通知（桌面右下角）。
  // 不需要时改为 false（修改后刷新或重启生效）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.jsonc）顶层覆盖，设置页保存宠物时会保留该字段。
  // 前台聚焦时是否也提醒，见下面 notifyWhenFocused。
  "notificationsEnabled": true,
  // ===================== 前台聚焦时也提醒 =====================
  // false（默认）= 维持「不打扰」：页面可见且持有焦点时不弹、不念，只在走开或被遮住时提醒。
  // true = 前台聚焦也照常弹系统通知、照常播报工作状态语音（设置页「全局开关」里
  //   「前台聚焦时也提醒」写的就是它）。
  // 缺这个键、或不是布尔，一律按 false 处理，旧配置升级后行为不变。
  "notifyWhenFocused": false,
  // ===================== 点击音效开关 =====================
  // true（默认）= 点一下宠物播一声内置音效（assets/sound/click-duck.wav，音量固定 0.5；
  //   100ms 内的连续点击只响一次，多开时也不会叠成一片）。
  // false = 完全静音（设置页「全局开关」里的「点击音效」写的就是它）。
  // 必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.jsonc）顶层覆盖，设置页「全局开关」里的开关写的就是它。
  // 只读 main 条目这一份（pet pack 种类文件不单独覆盖），改动后保存即生效。
  "clickSoundEnabled": true,
  // ===================== 锁定在当前屏幕（根字段，不属于 physics） =====================
  // 多屏用户：true = 宠物只在**当前所在那块屏幕**内活动——
  //   抛掷：只在松手时所在那块屏内弹（屏缝当墙，不飞到隔壁屏）；
  //   漫游：只在当前所在那块屏内走，越出屏缝的那一步直接取消（抛掷是逐帧物理边界，会撞回来；
  //         漫游是一次性落点规划、没有反弹语义，走不过去就不发车）。
  // false（默认）= 屏缝两侧都有屏时照常跨屏飞行 / 跨屏行走、落到隔壁屏（现状）。
  // 放根字段而不塞进 physics：它不改手感参数（重力/恢复系数/力度那些），只改「宠物被允许去哪」。
  // 必填布尔值，缺失即配置错误；也可在用户配置（main-config.jsonc）顶层覆盖，设置页开关写的就是它。
  // 全局默认：用户层写一次对**所有宠物**生效（含种类）；种类文件 pet/<名>-config.json 顶层写了则用自己那份。
  // 仅影响桌面模式（浏览器 overlay 本来就只在视口内活动）。改动后刷新或重启生效。
  "confineToScreen": false,
  // ===================== 系统托盘（仅桌面模式） =====================
  // 桌面模式启动后在通知区域（Windows）/ 菜单栏（macOS）常驻一个图标：列出配置里的**全部**宠物，
  // 勾选即可切换显示位置——包括 display 为 web / none（当前不在桌面、没有窗口可右键）的那些。
  // false = 不建托盘：不想在系统托盘留下痕迹，或同时跑多个桌面端 DSH（各占一个位置）时用。
  // 关掉的代价：桌面侧就没有「把不在桌面的宠物叫回桌面」的入口了，要开浏览器用设置页、
  // 或在网页端那只宠物身上右键切换。
  // 仅影响桌面模式（纯浏览器端本来就没有托盘）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.jsonc）顶层覆盖，设置页「全局开关」里的托盘开关写的就是它。
  // 改动后保存即生效（宿主会重启桌面 Helper，桌面宠物窗口会重建一次）。
  "trayEnabled": true,
  // ===================== 环境：天气查哪个城市（只读 main 条目） =====================
  // 留空（默认）= 按出口 IP 自动定位，IP 归属地库认为你在哪就查哪。
  // 填了就用它：交给她名接口按城市名查天气，不再走 IP 定位——IP 库把家宽标到省会或邻市时，
  // 手动填真实城市即可修正。填城市名，不要填省份（「江苏省」会被当成城市、落到省会南京）；
  // 「扬州」「扬州市」两种写法都可以，上游会自己归一化。清空 = 恢复自动定位。
  // 设置页「环境与定位」卡的输入框与「检测」按钮写的就是它（检测按钮取当前 IP 定位结果回填）。
  "environmentCity": "",
  // ===================== 工作状态联动文案（条目级，与 animations/physics 同级；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 工作状态气泡文本（pets[].workStatusEnabled 开启时展示；仅在 events.workStatus 动画触发时弹）。
  // 结构 = 二维数组，外层索引即档位（与 events.workStatus 动画索引一一对应，勿在中间插入新档）：
  //   0 thinking（turn/start）/ 1 working（tool/call）/ 2 result（tool/result）/
  //   3 waiting（approval/asked）/ 4 success（turn/end completed）/ 5 error（turn/end error/max-tokens）
  // 每档内是多个备选句，播放时随机抽一句（想固定单句就只写一个；想换文案只改这里）。
  // 省略整个字段 = 不弹工作状态气泡文本（仍播动画）；省略某档 = 该档不显示文本。
  "workStatusTexts": [
    ["正在认真想下一步呢", "让我整理一下思路~", "正在梳理接下来要做什么"],
    ["正在处理任务呢", "这一步正在进行中哦", "正在继续干活呢，别打扰我~"],
    ["这一步处理好啦，接着看下一步", "搞定一步，继续看看哦~"],
    ["需要你确认一下呢", "这里要等你看一下哦", "轮到你来决定啦，等你~"],
    ["这一轮搞定啦，真棒！", "任务完成咯，可以摸鱼啦~"],
    ["这一步好像没跑通呢", "刚才的操作遇到点问题哦", "这里卡了一下，再等等你呢"]
  ],
  // ===================== 宠物物理（拖拽抛掷手感，全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // gravity：抛掷下落/反弹的基础重力（px/s²）。默认 1400（数值越大落得越快）；0 = 无重力（合法，
  //   抛掷后匀速直线飞行/永不回落，配合 restitution/groundFriction=0 即纯无重力漂浮）。
  // restitution：碰壁反弹恢复系数，0~1（1 = 完全弹性，0 = 撞上即停；墙/地共用）。默认 0.78。
  // groundFriction：落地时水平速度的衰减率（/s，0 = 无摩擦冰面）。默认 2.5。
  // ceilingBounce：顶部是否反弹。true = 碰顶反弹（现状）；false = 顶部无边界，
  //   抛掷可飞出屏幕顶部（超出可视区域，重力仍会拉回落）。默认 true。
  // throwPower：总力度（拖拽/抛掷输出增益）。弹簧跟手（K/C）、甩抛初速与软上限 3600 整体 ×p：
  //   1.0 = 现状；>1 = 跟手更贴、甩得更猛、可达到的上限更高；<1 = 松弛、更易温柔放下。必须 > 0。
  // petCollision：多宠物互相碰撞开关。true（默认）= 飞行中被甩出的宠物撞到其它宠物时，
  //   按动量守恒 + 恢复系数 0.995 弹开（质量 ∝ size²）；false = 互相穿过（设置页「物理」卡可关）。
  // hapticEnabled：碰撞震动。true（默认）= 撞墙/落地/撞顶与宠物互撞时各震一下；
  //   只在支持 Vibration API 的浏览器生效（安卓），iOS 与桌面端没有硬件，会静默跳过。
  // tiltGravity：倾斜控制重力。true（默认）= 手机倾斜方向代替固定向下的重力（大小仍由 gravity 决定，
  //   竖直时取满值；gravity=0 时无从取值，等同关闭）；false = 关闭。
  // shakeThrow：摇一摇抛出。true（默认）= 摇一摇沿甩动方向把宠物甩出去（力度 = 基准 × throwPower），
  //   与重力大小无关，gravity=0 时也能甩；false = 关闭。
  //   两个体感开关都只在 HTTPS / localhost 下有效（传感器 API 只在安全上下文存在）。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": true,
    "hapticEnabled": true,
    "tiltGravity": true,
    "shakeThrow": true
  },
  // ===================== 字体（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // family：字体种类（预设 id，必须在白名单内，写错即配置错误 → 告警并取默认 noto）。
  //   可选：noto=思源黑体（内置，默认）/ yahei=微软雅黑·苹方 / youyuan=幼圆 / kaiti=楷体 /
  //   simsun=宋体 / comic=漫画体 / system=系统默认。
  //   作用范围：宠物气泡、悬浮提示、对话窗、得分弹窗。
  //   为什么只存 id 不存字体栈：字体栈是 CSS 片段，手改写错会把样式拼坏；id 有白名单可校验。
  //   各 id 对应的实际字体栈见 src/shared/fonts.ts 的 FONT_PRESETS（系统字体没装时由兜底栈接住）。
  // size：字号 px，**只影响气泡与悬浮提示**（对话窗与得分弹窗字号不变）。基准 = 气泡正文字号，
  //   悬浮提示与气泡内小字按既有比例派生。范围 4~200，默认 21（= 462 宽宠物原本的气泡字号）。
  // followPet：字号是否随宠物大小等比缩放。true（默认）= 按「实际 size ÷ 基准尺寸」缩放，
  //   与接入本配置前的行为完全一致（宠物调大，字跟着大）；false = 恒为 size px，不随宠物大小变。
  // 注意（对象字段都是整段替换）：要写就三个子键写全——只写一半会被判为整段非法，
  //   告警后整段回退默认值。设置页「外观与字体」区改这三项会整段写回，不受此影响。
  "font": {
    "family": "noto",
    "size": 21,
    "followPet": true
  },
  // ===================== 默认宠物列表（多开） =====================
  // pets 数组定义默认宠物；「设置页 → 添加宠物」的默认模板取 pets[0]（main）。
  // 每个宠物独立：name（显示名，可重复：悬浮提示 / AI 人设追加「你的名字是X」/ 未来命令行定位的
  //   显示层。可省略——缺失或留空按该宠物 id 处理并告警，兼容旧配置）、
  // id（唯一标识，程序定位用：素材/记忆/端点参数都按它，绝不重叠，冲突即配置错误）、
  // size（宽度 px，高度自动 = size × 9/16）、
  // balanceEnabled（是否启用余额功能：true=触发余额动画+显示余额气泡；false=该宠物完全禁用。
  //   必填布尔值，缺失即配置错误）、display（显示位置，必填四值之一：
  //   web=仅浏览器 overlay / desktop=仅桌面模式（Electron 透明窗）/ both=两者/ none=都不显示。
  //   缺失按默认 both 处理并告警（兼容 ≤0.2.0 旧配置），写了非法值即配置错误；桌面模式渲染
  //   display 含 desktop/both 的全部宠物，每只一个局部小窗）、
  // position（corner: 四角之一；marginX/marginY: 距所属角落偏移 px）、
  // whisperPrompt（可选：这只宠物自己的人设，写了取代条目顶层那份；不写/留空 = 跟随条目）
  "pets": [
    {
      "name": "CoWork",
      "id": "main",
      "size": 300,
      "balanceEnabled": false,
      // 碎碎念默认开启：每次生成都会调用当前对话的模型。本地 LLM 单并发时，
      // 后台碎碎念会顶掉正在跑的任务的 KV cache（与 DSH 多子代理同因）。
      // 不需要碎碎念的宠物改为 false（设置页也可开关）。
      "whisperEnabled": false,
      // 工作状态联动默认开启：监听 DSH 会话事件（工具调用等），按
      // animations.events.workStatus 数组切档位动画 + 气泡（仅监听，不调用模型）。
      "workStatusEnabled": true,
      // 宠物固定：true = 随机动画链不再抽「转向 / 移动」两档——宠物不自己翻朝向、也不自己
      // 走开，只播原地待机与随机小动作（两档原本的权重自然并入随机小动作，见文件末尾
      // animationWeights 的说明）。默认 false = 保持原行为（会自己走、会自己翻）。
      // **只影响随机链**：右键菜单点播（含「转向 / 移动」两项）、/anim 接口与命令、
      // 余额/碎碎念/工作状态事件动画、点击回应与拖拽一律照常——用户主动触发的不受此限制。
      // 设置页有同名勾选框。改动后刷新或重启生效。
      "fixedEnabled": false,
      "display": "web",
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
      // 想让这只宠物有自己的性格，就取消下面这行的注释（留空/不写 = 跟随文件顶层的 whisperPrompt）
      // "whisperPrompt": "你是主人桌面上的猫娘，说话简短、爱吐槽，20 字以内。"
    }
  ],

  // 动画名与 assets/webm 下的视频名一致。用户可以在 main-animation/webm 下覆盖同名文件。
  "animations": {
    "idle": [
      "工作_招手打招呼",
      "工作_敲打键盘",
      "工作_犹豫思考",
      "工作_疑问问号",
      "动作_吃冰淇淋",
      "动作_打哈欠",
      "动作_睡觉Z",
      "动作_跑步"
    ],
    "idleSequential": true,
    "turn": [],
    "drag": [],
    "clicks": ["工作_招手打招呼"],
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": []
    },
    "categories": [
      { "id": "CoWork", "weight": 0, "actions": [
        "工作_招手打招呼", "工作_敲打键盘", "工作_犹豫思考", "工作_疑问问号",
        "动作_吃冰淇淋", "动作_打哈欠", "动作_睡觉Z", "动作_跑步"
      ] }
    ],
    "events": {
      // 档位顺序：思考、工具运行、工具结果、等待确认、完成、失败。
      "workStatus": [
        "工作_犹豫思考",
        "工作_敲打键盘",
        "工作_犹豫思考",
        "工作_疑问问号",
        "工作_招手打招呼",
        "工作_疑问问号"
      ]
    },
    // 睡觉动作套：入睡（打哈欠）→ 睡姿循环（睡觉Z）→ 醒来（打哈欠）
    "sleep": [
      {
        "start": ["动作_打哈欠"],
        "loop": ["动作_睡觉Z"],
        "end": ["动作_打哈欠"]
      }
    ]
  },

  // ===================== 事件触发周期（全局默认：用户层写一次对所有宠物生效，种类文件顶层可覆盖） =====================
  // 事件名 → 刷新间隔（秒）。**整段替换**：写了就整段用自己的，缺的键不会从内置默认补回来。
  //   · whisper：碎碎念周期，按宠物所属条目读（种类可覆盖）；读不到按 300 兜底。
  //   · sleepTalk：睡觉时说梦话的周期，按宠物所属条目读（种类可覆盖）；读不到按 60 兜底。
  //     只对正在睡的宠物生效，醒来立刻停。
  //   · balance：余额数据刷新 + 余额动画触发的间隔，**消费端只读 main 条目**（余额数据一份、
  //     host 只有一个定时器，给不了每个种类一个周期）；读不到按 1800 兜底。启动时立即触发一次。
  // 非法数值（非正数/非数字）即整段配置错误 → 告警并回退内置默认。
  // 上限 2147483 秒（约 24.9 天）：超过它的周期按它算——再大的延时会被 setTimeout 当成 1 ms，
  // 反而变成每秒一次。
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300,
    "sleepTalk": 60
  },

  // 空闲时按 idle 的顺序循环，工作状态按上面的档位切换动作。
  "animationWeights": {
    "idle": 100,
    "turn": 0,
    "move": 0
  }
}
