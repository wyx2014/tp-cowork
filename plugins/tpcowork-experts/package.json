{
  "name": "@tpcowork/dsh-experts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/host.js",
    "./remote": "./lib/remote.js",
    "./client": "./lib/client.js",
    "./teams": "./lib/teams.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "resources",
    "locale/*.json",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node ../../../deepseek-harness/node_modules/vitest/vitest.mjs run --config vitest.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-workflow": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "react": "^19.0.0"
  }
}
